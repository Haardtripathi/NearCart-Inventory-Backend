DATABASE_URL=
PORT=5001
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_SECRET=
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=nearcart
LIBRETRANSLATE_URL=http://127.0.0.1:5000
AUTO_TRANSLATE_ON_WRITE=true
AUTO_TRANSLATE_FAIL_OPEN=true
TRANSLATION_CACHE_TTL_SECONDS=2592000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nearcart-inventory
IMAGE_UPLOAD_MAX_BYTES=5242880
MARKETPLACE_INTERNAL_TOKEN=
# Email delivery (used for account-setup / password-reset links and OTP codes).
# Priority: BREVO_API_KEY > SMTP > RESEND_API_KEY > console-log fallback.
# BREVO_API_KEY (HTTP API) is the top choice — confirmed 2026-08-01 that Brevo's own SMTP relay
# gets ETIMEDOUT on some Render service instances despite working on others (a real per-service
# network egress restriction), while the HTTP API isn't affected at all. Get a key at
# brevo.com > Settings > SMTP & API > API keys & MCP. IMPORTANT: disable IP authorization at
# app.brevo.com/security/authorised_ips first, or Render's (non-static) outbound IP will get
# rejected as "unrecognised."
BREVO_API_KEY=
BREVO_FROM=NearCart Inventory <no-reply@nearcart.app>
RESEND_API_KEY=
RESEND_FROM=NearCart Inventory <onboarding@resend.dev>
# Provider-agnostic SMTP (works with Brevo, Gmail, SES, etc.) — used only if BREVO_API_KEY is
# unset. Leave all unset in local dev to fall back to logging emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NearCart Inventory <no-reply@nearcart.app>
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Reverse-geocoding a dropped pin into address fields (branch location picker) and the Places
# Nearby Search used by POST /branches/:id/verification/photo's placeLocationMatch check. Reuse
# the same key already used by the sibling NearCart/backend repo's GOOGLE_MAPS_API_KEY — same
# Google Cloud project, no reason to provision a second key. Leave unset to skip
# geocoding/place-matching gracefully (manual address entry always still works either way).
GOOGLE_MAPS_API_KEY=
# Shop-photo clarity/name-OCR (POST /branches/:id/verification/photo) and driver
# vehicle-photo/license OCR (POST /driver/verification/*). Leave unset to run in stub mode — the
# driver verification endpoints return a clear 503 { error: "verification_unavailable" } instead
# of crashing the server; the shop-photo endpoint still accepts/stores the photo but leaves it
# PENDING_VERIFICATION until this is configured (onboarding is never hard-blocked on this alone).
REPLICATE_API_TOKEN=
