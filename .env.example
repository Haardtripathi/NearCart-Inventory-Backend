DATABASE_URL=
PORT=5001
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_SECRET=
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=nearcart
LIBRETRANSLATE_URL=http://127.0.0.1:5000
AUTO_TRANSLATE_ON_WRITE=true
AUTO_TRANSLATE_FAIL_OPEN=true
TRANSLATION_CACHE_TTL_SECONDS=2592000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nearcart-inventory
IMAGE_UPLOAD_MAX_BYTES=5242880
MARKETPLACE_INTERNAL_TOKEN=
# Email delivery (used for account-setup / password-reset links and OTP codes).
# Priority: BREVO_API_KEY > SMTP > RESEND_API_KEY > console-log fallback.
# BREVO_API_KEY (HTTP API) is the top choice — confirmed 2026-08-01 that Brevo's own SMTP relay
# gets ETIMEDOUT on some Render service instances despite working on others (a real per-service
# network egress restriction), while the HTTP API isn't affected at all. Get a key at
# brevo.com > Settings > SMTP & API > API keys & MCP. IMPORTANT: disable IP authorization at
# app.brevo.com/security/authorised_ips first, or Render's (non-static) outbound IP will get
# rejected as "unrecognised."
BREVO_API_KEY=
BREVO_FROM=NearCart Inventory <no-reply@nearcart.app>
RESEND_API_KEY=
RESEND_FROM=NearCart Inventory <onboarding@resend.dev>
# Provider-agnostic SMTP (works with Brevo, Gmail, SES, etc.) — used only if BREVO_API_KEY is
# unset. Leave all unset in local dev to fall back to logging emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NearCart Inventory <no-reply@nearcart.app>
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
