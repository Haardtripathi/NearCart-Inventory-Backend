# Environment for the automated test suite (tests/, run via `npm test`).
#
# HARD RULE: DATABASE_URL here must always be a local `file:` SQLite URL. tests/setup.ts throws
# immediately at test-file load time if it isn't — this file being misconfigured must never be
# able to route the suite at the real Turso database referenced by the real `.env`. No real
# secrets belong in this file; every value below is a disposable dummy safe to commit.
NODE_ENV=test
DATABASE_URL=file:./test.db
PORT=5011

JWT_SECRET=test-only-jwt-secret-do-not-use-in-prod-0123456789
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_SECRET=test-only-bootstrap-secret

CORS_ORIGIN=http://localhost:5173

# No Redis in the test environment — OTP-dependent flows (email verification) are deliberately
# not exercised by this suite (see tests/helpers/auth.ts / tests/helpers/driver.ts doc comments),
# so getRedisClient() returning null throughout is fine. The rate limiter falls back to an
# in-memory store when this is unset (see src/middlewares/rateLimit.middleware.ts).
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=nearcart-test

LIBRETRANSLATE_URL=http://127.0.0.1:5000
# Off in tests: avoids every catalog write attempting a real network call to an unstarted
# LibreTranslate instance. AUTO_TRANSLATE_FAIL_OPEN=true is kept as a defense-in-depth default
# even so.
AUTO_TRANSLATE_ON_WRITE=false
AUTO_TRANSLATE_FAIL_OPEN=true
TRANSLATION_CACHE_TTL_SECONDS=2592000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nearcart-inventory-test
IMAGE_UPLOAD_MAX_BYTES=5242880

MARKETPLACE_INTERNAL_TOKEN=test-only-marketplace-internal-token
NEARCART_SERVICE_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NearCart Inventory Test <no-reply@nearcart.test>
BREVO_API_KEY=
BREVO_FROM=NearCart Inventory Test <no-reply@nearcart.test>
RESEND_API_KEY=
RESEND_FROM=NearCart Inventory Test <onboarding@resend.dev>

OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

ORDER_CONFIRMATION_TIMEOUT_MINUTES=10

DRIVER_MATCH_RADIUS_KM=15
DRIVER_LOCATION_STALE_MINUTES=10
DRIVER_DELIVERY_FEE=30
DRIVER_FARE_BASE=20
DRIVER_FARE_PER_KM=8
DRIVER_FARE_MIN=20
DRIVER_FARE_MAX=150
DRIVER_JWT_EXPIRES_IN=1d
DRIVER_REFRESH_TTL_DAYS=90

GOOGLE_MAPS_API_KEY=
REPLICATE_API_TOKEN=
