{
  "name": "nearcart-inventory-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NearCart Inventory backend",
  "main": "dist/src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --signal SIGTERM --watch src --ext ts --exec \"node --import tsx src/server.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:catalog": "SEED_SCOPE=catalog prisma db seed",
    "translations:backfill": "node --import tsx src/scripts/backfill-translations.ts",
    "catalog:backfill": "node --import tsx src/scripts/backfill-industry-defaults.ts",
    "translate:start": "bash ../python/libretranslate/start-local.sh",
    "translate:check": "curl -sS -m 5 http://127.0.0.1:5000/languages > /dev/null && echo 'LibreTranslate is reachable at http://127.0.0.1:5000' || (echo 'LibreTranslate is NOT reachable. Auto-translate/translate-item calls will fail-open (return source text unchanged) until you run: npm run translate:start' && exit 1)",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-libsql": "7.6.0",
    "@prisma/client": "7.6.0",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "prisma": "7.6.0",
    "rate-limit-redis": "^4.3.1",
    "replicate": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "bcrypt@5.1.1": true,
    "esbuild@0.27.4": true,
    "protobufjs@7.6.5": true,
    "@prisma/engines@7.6.0": true,
    "prisma@7.6.0": true
  }
}
