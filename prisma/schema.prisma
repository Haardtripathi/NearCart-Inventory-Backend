model SalesOrder {
  id                     String           @id @default(cuid())
  organizationId         String
  branchId               String
  customerId             String?
  orderNumber            String
  source                 OrderSource
  status                 SalesOrderStatus @default(PENDING)
  paymentStatus          PaymentStatus    @default(UNPAID)
  subtotal               Decimal          @default(0)
  taxTotal               Decimal          @default(0)
  discountTotal          Decimal          @default(0)
  total                  Decimal          @default(0)
  notes                  String?
  rejectionReason        String?
  // Set at creation (createdAt + ORDER_CONFIRMATION_TIMEOUT_MINUTES). The order-confirmation
  // sweep cron auto-rejects PENDING orders past this deadline — null for orders created before
  // this column existed (never auto-cancelled, matching pre-existing behavior).
  confirmationDeadlineAt DateTime?
  // Structured per-order delivery address, shape `{ addressLine, latitude, longitude }`
  // (all nullable). Populated at bridge order-creation time from the marketplace bridge's
  // customer payload (see marketplace.service.ts createBridgedSalesOrder) — kept separate from
  // Customer.address since a returning customer may order to a different address each time.
  // Rows created before this column existed have deliveryAddress: null; readers (e.g.
  // driver-orders.serializeDriverOrder) should fall back to customer.address for those.
  deliveryAddress        Json?
  // Bridge fields: set when this order originated from NearCart's customer-facing app via the
  // marketplace bridge (see modules/marketplace). externalOrderId is NearCart's Order.id and is
  // unique so a replayed push is idempotent (see marketplace.service.ts createBridgedSalesOrder).
  externalOrderId        String?          @unique
  externalOrderNumber    String?
  createdById            String?
  confirmedById          String?
  deliveredById          String?
  readyById              String?
  readyAt                DateTime?
  assignedDriverId       String?
  assignedById           String?
  confirmedAt            DateTime?
  deliveredAt            DateTime?
  assignedAt             DateTime?
  pickedUpAt             DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  organization           Organization     @relation(fields: [organizationId], references: [id])
  branch                 Branch           @relation(fields: [branchId], references: [id])
  customer               Customer?        @relation(fields: [customerId], references: [id])
  createdBy              User?            @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  confirmedBy            User?            @relation("SalesOrderConfirmedBy", fields: [confirmedById], references: [id])
  deliveredBy            User?            @relation("SalesOrderDeliveredBy", fields: [deliveredById], references: [id])
  readyBy                User?            @relation("SalesOrderReadyBy", fields: [readyById], references: [id])
  assignedBy             User?            @relation("SalesOrderAssignedBy", fields: [assignedById], references: [id])
  assignedDriver         Driver?          @relation("SalesOrderAssignedDriver", fields: [assignedDriverId], references: [id])
  items                  SalesOrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([assignedDriverId, status])
  @@index([status, confirmationDeadlineAt])
  // Branch-scoped status counting (e.g. the marketplace bridge's active-order-count endpoint)
  // filters by branchId + status without organizationId in the WHERE — the existing
  // [organizationId, status] index above doesn't help there since branchId isn't its leading
  // column, so add a dedicated compound index.
  @@index([branchId, status])
}

// Drivers are a platform-wide pool, independent of User/OrganizationMembership (not tied to any
// one Organization) — self-serve registration starts PENDING_VERIFICATION, a platform
// SUPER_ADMIN verifies before login/assignment is allowed, and any org's staff can then assign
// any VERIFIED driver to a READY SalesOrder. See PHASE1_REQUIREMENTS.md's "Driver API contract"
// (locked 2026-07-24) and modules/driver-auth, modules/driver-orders, modules/drivers,
// modules/platform (verify/suspend endpoints).
model Driver {
  id                       String               @id @default(cuid())
  fullName                 String
  phone                    String               @unique
  email                    String?              @unique
  passwordHash             String
  vehicleType              String
  vehicleNumber            String
  status                   DriverStatus         @default(PENDING_VERIFICATION)
  // Separate trust signal from `status` (admin review) — proves the driver controls the inbox at
  // `email`, added as an ADDITIONAL gate alongside admin verification, not a replacement for it.
  // A driver can be emailVerified=true while status is still PENDING_VERIFICATION (email OTP is
  // completable before admin review finishes), and login remains blocked until status=VERIFIED
  // regardless of this flag. See modules/driver-auth/driver-auth.service.ts.
  emailVerified            Boolean              @default(false)
  // Nearest-free-driver auto-assignment (see sales-orders driver-matching service): a driver is
  // "free" when isAvailableForAssignment is true AND they have no SalesOrder currently assigned
  // with status READY/OUT_FOR_DELIVERY. lastKnownLatitude/Longitude are updated by a periodic
  // (~60s) foreground location ping from the driver app while online — deliberately NOT
  // continuous background tracking (Phase 1 explicitly defers live tracking).
  isAvailableForAssignment Boolean              @default(false)
  lastKnownLatitude        Float?
  lastKnownLongitude       Float?
  lastLocationAt           DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  assignedOrders           SalesOrder[]         @relation("SalesOrderAssignedDriver")
  refreshTokens            DriverRefreshToken[]

  @@index([status])
  @@index([isAvailableForAssignment])
}

// Mirrors NearCart/backend's RefreshToken model/rotation design (rotate-on-use, hashed storage,
// soft-revoke) — Driver previously had only a flat non-rotating JWT with no refresh mechanism at
// all, which can't support a months-long session safely.
model DriverRefreshToken {
  id        String    @id @default(cuid())
  driverId  String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([expiresAt])
}

// Shared by both shop-staff Users and Drivers since both live in this database — ownerType
// discriminates which table ownerId points into (no FK, since it's polymorphic).
model DeviceToken {
  id            String   @id @default(cuid())
  ownerType     String // 'USER' | 'DRIVER'
  ownerId       String
  expoPushToken String
  platform      String? // 'android' | 'ios'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerType, ownerId, expoPushToken])
  @@index([ownerType, ownerId])
}

