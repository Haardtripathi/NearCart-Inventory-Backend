generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  MANAGER
  STAFF
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchType {
  STORE
  WAREHOUSE
  DARK_STORE
}

enum ProductType {
  SIMPLE
  VARIABLE
  BUNDLE
  SERVICE
  RAW_MATERIAL
  FINISHED_GOOD
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LanguageCode {
  EN
  HI
  GU
}

enum ProductSourceType {
  MANUAL
  MASTER_TEMPLATE
}

enum TrackMethod {
  PIECE
  WEIGHT
  VOLUME
  LENGTH
}

enum OrderSource {
  APP
  WALK_IN
  PHONE
  WHATSAPP
  OTHER
}

enum SalesOrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PurchaseReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_CANCEL
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RESERVE
  RELEASE_RESERVE
  DAMAGE
  EXPIRED
}

enum ReferenceType {
  PURCHASE_RECEIPT
  SALES_ORDER
  STOCK_ADJUSTMENT
  STOCK_TRANSFER
  MANUAL
  SYSTEM
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  DAMAGED
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  CONSUMED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  STOCK_POST
  ORDER_CONFIRM
  ORDER_REJECT
  ORDER_DELIVER
  TRANSFER_APPROVE
  ORDER_READY
  ORDER_ASSIGN_DRIVER
  ORDER_PICKUP
  DRIVER_REGISTER
  DRIVER_VERIFY
  DRIVER_SUSPEND
  DRIVER_EMAIL_VERIFY
  // Neither of these existed before — cancelSalesOrder previously logged plain UPDATE for every
  // cancel (staff and otherwise), unlike every other transition (CONFIRM/REJECT/DELIVER/READY),
  // which all have dedicated actions. Splitting into a staff-initiated action and a
  // bridge-initiated one both fixes that inconsistency and gives the marketplace bridge's new
  // cancel endpoint (PATCH .../sales-orders/by-external/:externalOrderId/cancel) reporting
  // granularity distinct from staff-initiated cancels, per PHASE1_REQUIREMENTS.md's bridge-cancel
  // work.
  ORDER_CANCEL
  ORDER_CANCEL_BRIDGE
}

enum DriverStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

enum UserActionTokenPurpose {
  ACCOUNT_SETUP
  PASSWORD_RESET
}

enum StockTransferStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model User {
  id                      String                   @id @default(cuid())
  fullName                String
  email                   String                   @unique
  passwordHash            String?
  platformRole            UserRole?
  preferredLanguage       LanguageCode             @default(EN)
  isActive                Boolean                  @default(true)
  passwordSetupRequired   Boolean                  @default(false)
  emailVerified           Boolean                  @default(false)
  passwordChangedAt       DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             OrganizationMembership[]
  invitedMemberships      OrganizationMembership[] @relation("MembershipInvitedBy")
  actionTokens            UserActionToken[]        @relation("UserActionTokenUser")
  createdActionTokens     UserActionToken[]        @relation("UserActionTokenCreatedBy")
  createdProducts         Product[]                @relation("ProductCreatedBy")
  updatedProducts         Product[]                @relation("ProductUpdatedBy")
  inventoryLedgers        InventoryLedger[]        @relation("InventoryLedgerCreatedBy")
  createdPurchaseReceipts PurchaseReceipt[]        @relation("PurchaseReceiptCreatedBy")
  createdSalesOrders      SalesOrder[]             @relation("SalesOrderCreatedBy")
  confirmedSalesOrders    SalesOrder[]             @relation("SalesOrderConfirmedBy")
  deliveredSalesOrders    SalesOrder[]             @relation("SalesOrderDeliveredBy")
  readySalesOrders        SalesOrder[]             @relation("SalesOrderReadyBy")
  assignedSalesOrders     SalesOrder[]             @relation("SalesOrderAssignedBy")
  createdStockTransfers   StockTransfer[]          @relation("StockTransferCreatedBy")
  approvedStockTransfers  StockTransfer[]          @relation("StockTransferApprovedBy")
  auditLogs               AuditLog[]               @relation("AuditActor")

  @@index([platformRole])
}

model Organization {
  id               String                       @id @default(cuid())
  name             String
  slug             String                       @unique
  legalName        String?
  phone            String?
  email            String?
  status           OrganizationStatus           @default(ACTIVE)
  currencyCode     String                       @default("INR")
  timezone         String                       @default("Asia/Kolkata")
  defaultLanguage  LanguageCode                 @default(EN)
  enabledLanguages Json?                        @default("[\"EN\", \"HI\", \"GU\"]")
  settings         Json?
  // Per-organization sidebar module visibility toggles (key -> boolean). Missing keys fall back
  // to the hardcoded defaults in `src/constants/pageVisibility.ts`. Additive, nullable, no
  // migration risk to existing rows.
  enabledPages     Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  deletedAt        DateTime?
  memberships      OrganizationMembership[]
  industryConfigs  OrganizationIndustryConfig[]
  branches         Branch[]
  categories       Category[]
  brands           Brand[]
  units            Unit[]
  taxRates         TaxRate[]
  suppliers        Supplier[]
  customers        Customer[]
  products         Product[]
  variants         ProductVariant[]
  balances         InventoryBalance[]
  inventoryLedger  InventoryLedger[]
  inventoryBatches InventoryBatch[]
  serialNumbers    SerialNumber[]
  purchaseReceipts PurchaseReceipt[]
  salesOrders      SalesOrder[]
  stockTransfers   StockTransfer[]
  auditLogs        AuditLog[]
  userActionTokens UserActionToken[]

  @@index([deletedAt])
}

model OrganizationMembership {
  id              String           @id @default(cuid())
  userId          String
  organizationId  String
  role            UserRole
  status          MembershipStatus @default(ACTIVE)
  isDefault       Boolean          @default(false)
  branchAccess    Json?
  invitedByUserId String?
  invitedAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  organization    Organization     @relation(fields: [organizationId], references: [id])
  invitedBy       User?            @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
}

model UserActionToken {
  id              String                 @id @default(cuid())
  userId          String
  createdByUserId String?
  organizationId  String?
  purpose         UserActionTokenPurpose
  tokenHash       String                 @unique
  expiresAt       DateTime
  usedAt          DateTime?
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation("UserActionTokenUser", fields: [userId], references: [id])
  createdBy       User?                  @relation("UserActionTokenCreatedBy", fields: [createdByUserId], references: [id])
  organization    Organization?          @relation(fields: [organizationId], references: [id])

  @@index([userId, purpose, usedAt, expiresAt])
  @@index([organizationId])
}

model Industry {
  id                      String                       @id @default(cuid())
  code                    String                       @unique
  name                    String                       @unique
  description             String?
  isActive                Boolean                      @default(true)
  defaultFeatures         Json
  defaultSettings         Json?
  customFieldDefinitions  Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  organizationConfigs     OrganizationIndustryConfig[]
  translations            IndustryTranslation[]
  masterCatalogCategories MasterCatalogCategory[]
  masterCatalogItems      MasterCatalogItem[]
  products                Product[]
}

model OrganizationIndustryConfig {
  id              String       @id @default(cuid())
  organizationId  String
  industryId      String
  isPrimary       Boolean      @default(false)
  enabledFeatures Json
  customSettings  Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  industry        Industry     @relation(fields: [industryId], references: [id])

  @@unique([organizationId, industryId])
  @@index([organizationId])
  @@index([industryId])
}

model Branch {
  id               String             @id @default(cuid())
  organizationId   String
  code             String? // Optional - auto-generated if not provided
  name             String
  type             BranchType
  phone            String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  isActive         Boolean            @default(true)
  // Pickup-point coordinates for nearest-driver distance matching (see Driver.lastKnownLatitude
  // below) — nullable since existing branches predate this column; backfilled by shop owners
  // editing branch details going forward.
  latitude         Float?
  longitude        Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  organization     Organization       @relation(fields: [organizationId], references: [id])
  balances         InventoryBalance[]
  inventoryLedger  InventoryLedger[]
  inventoryBatches InventoryBatch[]
  serialNumbers    SerialNumber[]
  purchaseReceipts PurchaseReceipt[]
  salesOrders      SalesOrder[]
  transfersFrom    StockTransfer[]    @relation("TransferFromBranch")
  transfersTo      StockTransfer[]    @relation("TransferToBranch")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
}

model Category {
  id             String                @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  description    String?
  isActive       Boolean               @default(true)
  sortOrder      Int                   @default(0)
  customFields   Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  organization   Organization          @relation(fields: [organizationId], references: [id])
  parent         Category?             @relation("CategoryToCategory", fields: [parentId], references: [id])
  children       Category[]            @relation("CategoryToCategory")
  translations   CategoryTranslation[]
  products       Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
  @@index([organizationId, deletedAt])
}

model Brand {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id])
  products       Product[]
  translations   BrandTranslation[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
}

model Unit {
  id              String            @id @default(cuid())
  organizationId  String?
  code            String
  name            String
  symbol          String?
  isSystem        Boolean           @default(false)
  allowsDecimal   Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization?     @relation(fields: [organizationId], references: [id])
  primaryProducts Product[]         @relation("ProductPrimaryUnit")
  variants        ProductVariant[]  @relation("VariantUnit")
  translations    UnitTranslation[]

  @@unique([organizationId, code])
  @@index([code])
}

model TaxRate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String?
  rate           Decimal
  isInclusive    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@index([organizationId, isActive])
}

model Supplier {
  id               String                @id @default(cuid())
  organizationId   String
  name             String
  code             String?
  phone            String?
  email            String?
  taxNumber        String?
  address          Json?
  notes            String?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  organization     Organization          @relation(fields: [organizationId], references: [id])
  purchaseReceipts PurchaseReceipt[]
  translations     SupplierTranslation[]

  @@index([organizationId, deletedAt])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        Json?
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
  salesOrders    SalesOrder[]

  @@index([organizationId, deletedAt])
}

model Product {
  id                   String                @id @default(cuid())
  organizationId       String
  categoryId           String?
  brandId              String?
  taxRateId            String?
  industryId           String?
  masterCatalogItemId  String?
  name                 String
  slug                 String
  description          String?
  productType          ProductType
  sourceType           ProductSourceType     @default(MANUAL)
  status               ProductStatus         @default(ACTIVE)
  hasVariants          Boolean               @default(false)
  trackInventory       Boolean               @default(true)
  allowBackorder       Boolean               @default(false)
  allowNegativeStock   Boolean               @default(false)
  trackMethod          TrackMethod           @default(PIECE)
  primaryUnitId        String?
  imageUrl             String?
  tags                 Json?
  customFields         Json?
  metadata             Json?
  createdById          String?
  updatedById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  organization         Organization          @relation(fields: [organizationId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  brand                Brand?                @relation(fields: [brandId], references: [id])
  taxRate              TaxRate?              @relation(fields: [taxRateId], references: [id])
  industry             Industry?             @relation(fields: [industryId], references: [id])
  masterCatalogItem    MasterCatalogItem?    @relation(fields: [masterCatalogItemId], references: [id])
  primaryUnit          Unit?                 @relation("ProductPrimaryUnit", fields: [primaryUnitId], references: [id])
  createdBy            User?                 @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy            User?                 @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  translations         ProductTranslation[]
  variants             ProductVariant[]
  balances             InventoryBalance[]
  inventoryLedger      InventoryLedger[]
  purchaseReceiptItems PurchaseReceiptItem[]
  salesOrderItems      SalesOrderItem[]
  stockTransferItems   StockTransferItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([organizationId, masterCatalogItemId])
}

model ProductVariant {
  id                   String                      @id @default(cuid())
  organizationId       String
  productId            String
  name                 String
  sku                  String
  barcode              String?
  attributes           Json?
  costPrice            Decimal
  sellingPrice         Decimal
  mrp                  Decimal?
  reorderLevel         Decimal                     @default(0)
  minStockLevel        Decimal                     @default(0)
  maxStockLevel        Decimal?
  weight               Decimal?
  unitId               String?
  isDefault            Boolean                     @default(false)
  isActive             Boolean                     @default(true)
  imageUrl             String?
  customFields         Json?
  metadata             Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
  organization         Organization                @relation(fields: [organizationId], references: [id])
  product              Product                     @relation(fields: [productId], references: [id])
  unit                 Unit?                       @relation("VariantUnit", fields: [unitId], references: [id])
  translations         ProductVariantTranslation[]
  balances             InventoryBalance[]
  inventoryLedger      InventoryLedger[]
  inventoryBatches     InventoryBatch[]
  serialNumbers        SerialNumber[]
  purchaseReceiptItems PurchaseReceiptItem[]
  salesOrderItems      SalesOrderItem[]
  stockTransferItems   StockTransferItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([productId, deletedAt])
  @@index([organizationId, deletedAt])
}

model IndustryTranslation {
  id          String       @id @default(cuid())
  industryId  String
  language    LanguageCode
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  industry    Industry     @relation(fields: [industryId], references: [id])

  @@unique([industryId, language])
  @@index([language])
}

model CategoryTranslation {
  id          String       @id @default(cuid())
  categoryId  String
  language    LanguageCode
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    Category     @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, language])
  @@index([language])
}

model BrandTranslation {
  id        String       @id @default(cuid())
  brandId   String
  language  LanguageCode
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  brand     Brand        @relation(fields: [brandId], references: [id])

  @@unique([brandId, language])
  @@index([language])
}

model UnitTranslation {
  id        String       @id @default(cuid())
  unitId    String
  language  LanguageCode
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  unit      Unit         @relation(fields: [unitId], references: [id])

  @@unique([unitId, language])
  @@index([language])
}

model SupplierTranslation {
  id         String       @id @default(cuid())
  supplierId String
  language   LanguageCode
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  supplier   Supplier     @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, language])
  @@index([language])
}

model ProductTranslation {
  id          String       @id @default(cuid())
  productId   String
  language    LanguageCode
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  product     Product      @relation(fields: [productId], references: [id])

  @@unique([productId, language])
  @@index([language])
}

model ProductVariantTranslation {
  id        String         @id @default(cuid())
  variantId String
  language  LanguageCode
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, language])
  @@index([language])
}

model EntityFieldTranslation {
  id         String       @id @default(cuid())
  entityType String
  entityId   String
  fieldKey   String
  language   LanguageCode
  value      String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([entityType, entityId, fieldKey, language], map: "EntityFieldTranslation_entityType_entityId_fieldKey_languag_key")
  @@index([entityType, entityId])
  @@index([entityType, fieldKey, language])
}

model MasterCatalogCategory {
  id           String                             @id @default(cuid())
  industryId   String
  parentId     String?
  code         String
  slug         String
  sortOrder    Int                                @default(0)
  iconKey      String?
  imageUrl     String?
  isActive     Boolean                            @default(true)
  metadata     Json?
  createdAt    DateTime                           @default(now())
  updatedAt    DateTime                           @updatedAt
  industry     Industry                           @relation(fields: [industryId], references: [id])
  parent       MasterCatalogCategory?             @relation("MasterCatalogCategoryToCategory", fields: [parentId], references: [id])
  children     MasterCatalogCategory[]            @relation("MasterCatalogCategoryToCategory")
  translations MasterCatalogCategoryTranslation[]
  items        MasterCatalogItem[]

  @@unique([industryId, code])
  @@unique([industryId, slug])
  @@index([industryId, parentId])
  @@index([industryId, isActive])
}

model MasterCatalogCategoryTranslation {
  id               String                @id @default(cuid())
  masterCategoryId String
  language         LanguageCode
  name             String
  description      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  masterCategory   MasterCatalogCategory @relation(fields: [masterCategoryId], references: [id])

  @@unique([masterCategoryId, language])
  @@index([language])
}

model MasterCatalogItem {
  id                   String                         @id @default(cuid())
  industryId           String
  masterCategoryId     String?
  code                 String                         @unique
  slug                 String                         @unique
  canonicalName        String
  canonicalDescription String?
  productType          ProductType
  defaultTrackMethod   TrackMethod
  defaultUnitCode      String?
  defaultBrandName     String?
  defaultTaxCode       String?
  hasVariants          Boolean                        @default(false)
  trackInventory       Boolean                        @default(true)
  allowBackorder       Boolean                        @default(false)
  allowNegativeStock   Boolean                        @default(false)
  defaultImageUrl      String?
  tags                 Json?
  customFieldsTemplate Json?
  metadata             Json?
  searchText           String
  isActive             Boolean                        @default(true)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  industry             Industry                       @relation(fields: [industryId], references: [id])
  category             MasterCatalogCategory?         @relation(fields: [masterCategoryId], references: [id])
  translations         MasterCatalogItemTranslation[]
  aliases              MasterCatalogItemAlias[]
  variantTemplates     MasterCatalogVariantTemplate[]
  importedProducts     Product[]

  @@index([industryId, masterCategoryId])
  @@index([industryId, isActive])
}

model MasterCatalogItemTranslation {
  id           String            @id @default(cuid())
  masterItemId String
  language     LanguageCode
  name         String
  shortName    String?
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  masterItem   MasterCatalogItem @relation(fields: [masterItemId], references: [id])

  @@unique([masterItemId, language])
  @@index([language])
}

model MasterCatalogItemAlias {
  id           String            @id @default(cuid())
  masterItemId String
  language     LanguageCode
  value        String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  masterItem   MasterCatalogItem @relation(fields: [masterItemId], references: [id])

  @@index([masterItemId])
  @@index([language, value])
}

model MasterCatalogVariantTemplate {
  id                  String                            @id @default(cuid())
  masterItemId        String
  code                String
  name                String
  skuSuffix           String?
  barcode             String?
  attributes          Json?
  defaultCostPrice    Decimal?
  defaultSellingPrice Decimal?
  defaultMrp          Decimal?
  reorderLevel        Decimal                           @default(0)
  minStockLevel       Decimal                           @default(0)
  maxStockLevel       Decimal?
  weight              Decimal?
  unitCode            String?
  isDefault           Boolean                           @default(false)
  isActive            Boolean                           @default(true)
  sortOrder           Int                               @default(0)
  metadata            Json?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  masterItem          MasterCatalogItem                 @relation(fields: [masterItemId], references: [id])
  translations        MasterCatalogVariantTranslation[]

  @@unique([masterItemId, code])
  @@index([masterItemId, isActive])
}

model MasterCatalogVariantTranslation {
  id                      String                       @id @default(cuid())
  masterVariantTemplateId String
  language                LanguageCode
  name                    String
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  masterVariantTemplate   MasterCatalogVariantTemplate @relation(fields: [masterVariantTemplateId], references: [id])

  @@unique([masterVariantTemplateId, language])
  @@index([language])
}

model InventoryBalance {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String
  productId      String
  variantId      String
  onHand         Decimal        @default(0)
  reserved       Decimal        @default(0)
  incoming       Decimal        @default(0)
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([organizationId, branchId, variantId])
  @@index([organizationId])
  @@index([branchId])
  @@index([variantId])
}

model InventoryLedger {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  productId      String
  variantId      String
  movementType   StockMovementType
  referenceType  ReferenceType
  referenceId    String?
  quantityDelta  Decimal
  unitCost       Decimal?
  beforeOnHand   Decimal
  afterOnHand    Decimal
  beforeReserved Decimal
  afterReserved  Decimal
  note           String?
  batchId        String?
  createdById    String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  product        Product           @relation(fields: [productId], references: [id])
  variant        ProductVariant    @relation(fields: [variantId], references: [id])
  batch          InventoryBatch?   @relation(fields: [batchId], references: [id])
  createdBy      User?             @relation("InventoryLedgerCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([variantId])
  @@index([createdAt])
}

model InventoryBatch {
  id              String            @id @default(cuid())
  organizationId  String
  branchId        String
  variantId       String
  batchNumber     String
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantityOnHand  Decimal           @default(0)
  purchasePrice   Decimal?
  sellingPrice    Decimal?
  status          BatchStatus       @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id])
  branch          Branch            @relation(fields: [branchId], references: [id])
  variant         ProductVariant    @relation(fields: [variantId], references: [id])
  inventoryLedger InventoryLedger[]

  @@unique([organizationId, branchId, variantId, batchNumber])
  @@index([organizationId, expiryDate])
}

